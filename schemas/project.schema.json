{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/project.schema.json",
  "title": "project",
  "description": "Project brief written in Step 1 and extended later.",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "contract": {
          "enum": [
            "",
            "time-and-materials",
            "fixed-price",
            "retainer"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "client"
      ],
      "additionalProperties": true
    },
    "documents": {
      "type": "object"
    },
    "timeline": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "dates_status": {
                "enum": [
                  "confirmed",
                  "inferred"
                ]
              },
              "depends_on": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "start",
              "end"
            ],
            "additionalProperties": true
          }
        },
        "sprints": {
          "type": "object",
          "properties": {
            "length_weeks": {
              "type": "integer",
              "minimum": 0
            },
            "first_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "id",
              "title",
              "date"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "sprints": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "used"
      ],
      "additionalProperties": true
    },
    "shared_artefacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "stated_by": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "open",
              "matches",
              "contradicts",
              "unverifiable",
              "resolved"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "environments": {
      "type": "object"
    },
    "draft_team": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "project"
  ],
  "additionalProperties": true
}
