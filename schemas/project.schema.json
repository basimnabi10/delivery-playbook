{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/project.schema.json",
  "title": "project",
  "description": "Project brief written in Step 1 and extended later.",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "contract": {
          "enum": [
            "",
            "time-and-materials",
            "fixed-price",
            "retainer"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "client"
      ],
      "additionalProperties": true
    },
    "documents": {
      "type": "object"
    },
    "timeline": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "dates_status": {
                "enum": [
                  "confirmed",
                  "inferred"
                ]
              },
              "depends_on": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "start",
              "end"
            ],
            "additionalProperties": true
          }
        },
        "sprints": {
          "type": "object",
          "properties": {
            "length_weeks": {
              "type": "integer",
              "minimum": 0
            },
            "first_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "id",
              "title",
              "date"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "description": "How the project runs, asked in Step 1. The Delivery Hub is updated weekly whatever the method.",
      "properties": {
        "method": {
          "enum": [
            "",
            "sprints",
            "kanban",
            "other"
          ]
        },
        "sprint_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Sprints only: calendar days in a sprint, for example 14."
        },
        "sprint_starts": {
          "enum": [
            "",
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "first_sprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sprints only: the start date of sprint 1."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sprints": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "used"
      ],
      "additionalProperties": true
    },
    "shared_artefacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "stated_by": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "open",
              "matches",
              "contradicts",
              "unverifiable",
              "resolved"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "environments": {
      "type": "object"
    },
    "draft_team": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conventions": {
      "type": "object",
      "description": "The project's choices for the playbook's conventions (schemas/conventions.yml), grouped as git, releases, environments and layout. Only choices that differ from the recommendation need to be listed, each with a reason. Write it with scripts/conventions.py, which also keeps the deviation log.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "choice": {},
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "choice"
          ],
          "additionalProperties": false
        }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "prepared_by": {
          "type": "string"
        },
        "eyebrow_tag": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "weekday": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "brand": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "logo_light": {
              "type": "string"
            },
            "logo_dark": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "tone": {
                "enum": [
                  "primary",
                  "go"
                ]
              }
            },
            "required": [
              "label",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "footer_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "staging_label": {
          "type": "string",
          "minLength": 1,
          "description": "The text for the staging environment, used for every change chip and in the legend (default: Staging)."
        }
      },
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "project"
  ],
  "additionalProperties": true
}
