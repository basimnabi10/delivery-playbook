{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/security.schema.json",
  "title": "security",
  "description": "Security and data handling cards, each with a last-verified date.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "security"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "inferred": {
            "type": "boolean",
            "description": "true when last_verified was inferred rather than recorded. Never rendered; validate lists it for the reviewer."
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "last_verified"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    },
    "note_links": {
      "type": "array",
      "description": "Optional links shown with the note, for example the production and staging addresses, when the project has decided the client may see them.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "caveat": {
      "type": "string"
    },
    "caveat_links": {
      "type": "array",
      "description": "Optional links shown with the caveat.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "cards"
  ],
  "additionalProperties": false
}
