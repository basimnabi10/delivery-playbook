{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/security.schema.json",
  "title": "security",
  "description": "Security and data handling cards, each with a last-verified date.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "security"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "last_verified"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    },
    "caveat": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "cards"
  ],
  "additionalProperties": false
}
