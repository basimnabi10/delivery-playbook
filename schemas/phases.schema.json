{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/phases.schema.json",
  "title": "phases",
  "description": "Phase bands for the delivery timeline.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "phases"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "short_label": {
            "type": "string",
            "minLength": 1,
            "description": "Optional short label for the phase's band on the timeline, used when the full name does not fit."
          },
          "gap_short_label": {
            "type": "string",
            "minLength": 1,
            "description": "Optional short label for the band of the gap before this phase."
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dates_status": {
            "enum": [
              "confirmed",
              "inferred"
            ]
          },
          "depends_on": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "start",
          "end",
          "dates_status"
        ],
        "additionalProperties": false
      }
    },
    "explainer": {
      "type": "string",
      "description": "Optional text that explains the timeline chart to the client. Shown as the timeline's introduction instead of the default one."
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "phases"
  ],
  "additionalProperties": false
}
