{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/manifest.schema.json",
  "title": "manifest",
  "description": "Index of the copies or locations in a folder. For Drive, it is the list of declared file ids. Item paths resolve relative to the manifest's own folder, not the repo root. Copies under product/internal/ and qa/internal/ have no manifest of their own: the project's documents manifest (project/internal/documents/index.yml) lists them, with paths such as ../../../qa/internal/test-plans/plan.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "manifest"
    },
    "kind": {
      "enum": [
        "meetings",
        "documents",
        "architecture",
        "chat-digests"
      ]
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "audience": {
            "enum": [
              "client",
              "internal"
            ]
          },
          "visibility": {
            "enum": [
              "client-visible",
              "internal",
              "restricted"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string"
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hash": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Relative to this manifest's folder (for example transcripts/2026-11-02-sync.md, or ../../../qa/internal/test-plans/plan.md for a QA copy listed in a project manifest)."
          },
          "gist": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[^\\n]*$"
          },
          "redactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "rule",
                "count",
                "date"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "visibility",
          "source",
          "retrieved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "kind",
    "updated",
    "items"
  ],
  "additionalProperties": false
}
