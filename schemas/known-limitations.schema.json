{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/known-limitations.schema.json",
  "title": "known-limitations",
  "description": "Register of known limitations, with the release each was opened and resolved in.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "known-limitations"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string"
          },
          "opened_in": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolved_in": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "opened_in",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "limitations"
  ],
  "additionalProperties": false
}
