{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/meeting-summary.schema.json",
  "title": "meeting-summary",
  "description": "Front matter of a meeting summary.",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "enum": [
        "client",
        "internal"
      ]
    },
    "attendees_by_role": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transcript_hash": {
      "type": "string",
      "minLength": 1
    },
    "generated": {
      "const": true
    }
  },
  "required": [
    "date",
    "title",
    "audience",
    "attendees_by_role",
    "transcript_hash",
    "generated"
  ],
  "additionalProperties": false
}
