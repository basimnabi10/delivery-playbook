{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/flags.schema.json",
  "title": "flags",
  "description": "Feature flags that decide whether a change counts as shipped.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "flags"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": "string",
            "minLength": 1
          },
          "set_in": {
            "type": "string"
          },
          "on_page": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "default",
          "on_page"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "flags"
  ],
  "additionalProperties": false
}
