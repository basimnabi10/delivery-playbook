{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/weekly-prs.schema.json",
  "title": "weekly-prs",
  "description": "Merged pull requests per week, written by the count script.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "weekly-prs"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "week_rule": {
      "type": "string",
      "minLength": 1
    },
    "time_zone": {
      "type": "string",
      "minLength": 1
    },
    "script_version": {
      "type": "string",
      "minLength": 1
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "partial_week": {
      "type": "boolean"
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week_ending": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "merged": {
            "type": "integer",
            "minimum": 0
          },
          "by_repo": {
            "type": "object"
          }
        },
        "required": [
          "week_ending",
          "merged"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "week_rule",
    "time_zone",
    "script_version",
    "total",
    "partial_week",
    "weeks"
  ],
  "additionalProperties": false
}
