{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chat-digest",
  "description": "Front matter of a monthly chat digest in project/internal/chat/.",
  "type": "object",
  "properties": {
    "source": {
      "enum": [
        "slack",
        "rocketchat",
        "teams",
        "chat"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "visibility": {
      "const": "internal"
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "threads_read": {
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "source_id",
    "period",
    "retrieved",
    "visibility",
    "content_hash"
  ],
  "additionalProperties": false
}