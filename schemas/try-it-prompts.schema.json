{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/try-it-prompts.schema.json",
  "title": "try-it-prompts",
  "description": "Curated, client-safe prompts the client can try.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "try-it-prompts"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suite": {
      "type": "string"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "suite_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "good_answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "category",
          "prompt",
          "good_answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "prompts"
  ],
  "additionalProperties": false
}
