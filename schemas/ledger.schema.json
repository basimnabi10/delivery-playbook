{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ledger.schema.json",
  "title": "ledger",
  "description": "The playbook ledger: what was wrong, unclear or missing in the playbook while a project ran it. Raw text stays in the private delivery repo; only an approved, generic draft is ever filed as an issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "ledger"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "step",
          "kind",
          "severity",
          "raw",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{3,}$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "playbook_version": {
            "type": "string"
          },
          "step": {
            "type": "string",
            "pattern": "^(0|1|2|3|4|5|6|7|joining|adopting|layout|scripts|template|feedback|other)$"
          },
          "file": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "gap",
              "wrong",
              "unclear",
              "friction",
              "idea",
              "bug",
              "worked"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "friction",
              "minor"
            ]
          },
          "raw": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "drafted",
              "approved",
              "filed",
              "commented",
              "skipped",
              "duplicate"
            ]
          },
          "draft": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "issue": {
            "type": "string",
            "description": "The issue link (filed), or the comment link ending #issuecomment-<number> (commented)."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
