{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/sprints.schema.json",
  "title": "sprints",
  "description": "Optional. One entry per sprint: goal, dates, what was delivered and what carried over. Shown on the Sprints page when the project uses formal sprints.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sprints"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "delivered": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "carried_over": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "sprints"
  ],
  "additionalProperties": false
}
