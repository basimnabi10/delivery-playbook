{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/release.schema.json",
  "title": "release",
  "description": "One release: highlights, changes, notes for IT, in progress, and ids of prompts and limitations.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "release"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "enum": [
              "production",
              "staging",
              "internal-testing"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reconstructed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "area",
          "tag",
          "environment",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "it_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "try_it_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "version",
    "highlights",
    "changes"
  ],
  "additionalProperties": false
}
