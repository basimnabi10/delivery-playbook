{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/state.schema.json",
  "title": "state",
  "description": "Progress and source checks, written by the agent.",
  "type": "object",
  "properties": {
    "playbook_version": {
      "type": "string"
    },
    "playbook_date": {
      "type": "string"
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "step",
        "done"
      ],
      "additionalProperties": true
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "covered_through": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "sources_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "connector",
              "api",
              "browser",
              "manual"
            ]
          },
          "read_depth": {
            "enum": [
              "titles",
              "partial",
              "full"
            ]
          },
          "time": {
            "type": "string"
          },
          "result": {
            "enum": [
              "read",
              "partial",
              "not read"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "method",
          "result"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "onboarding",
    "covered_through"
  ],
  "additionalProperties": true
}
