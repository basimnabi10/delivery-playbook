{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/capabilities.schema.json",
  "title": "capabilities",
  "description": "What the product does today, in areas.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "capabilities"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "since_release": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "live",
                    "beta",
                    "planned",
                    "off"
                  ]
                }
              },
              "required": [
                "id",
                "text",
                "since_release",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "areas"
  ],
  "additionalProperties": false
}
