{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/team.schema.json",
  "title": "team",
  "description": "Who is on the project and who holds each function.",
  "type": "object",
  "properties": {
    "functions": {
      "type": "object",
      "properties": {
        "project-management": {
          "type": "object",
          "description": "A function's owner and backups. backup may be one id or a list; backups is a list. Both are read.",
          "properties": {
            "owner": {
              "type": "string"
            },
            "backup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "backups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "product-management": {
          "type": "object",
          "description": "A function's owner and backups. backup may be one id or a list; backups is a list. Both are read.",
          "properties": {
            "owner": {
              "type": "string"
            },
            "backup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "backups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "design": {
          "type": "object",
          "description": "A function's owner and backups. backup may be one id or a list; backups is a list. Both are read.",
          "properties": {
            "owner": {
              "type": "string"
            },
            "backup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "backups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "qa": {
          "type": "object",
          "description": "A function's owner and backups. backup may be one id or a list; backups is a list. Both are read.",
          "properties": {
            "owner": {
              "type": "string"
            },
            "backup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "backups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": {
        "type": "object",
        "description": "A function's owner and backups. backup may be one id or a list; backups is a list. Both are read.",
        "properties": {
          "owner": {
            "type": "string"
          },
          "backup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "backups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "description": "The four playbook functions, plus any others the project uses (such as engineering). check_writers.py and codeowners.py only act on the four."
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "org": {
            "enum": [
              "internal",
              "client"
            ]
          },
          "role": {
            "type": "string"
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The functions this person holds. Names beyond the four playbook functions are allowed and ignored by check_writers.py."
          },
          "handles": {
            "type": "object"
          },
          "tier": {
            "enum": [
              "light",
              "full"
            ]
          },
          "client_facing": {
            "type": "boolean"
          },
          "engagement": {
            "enum": [
              "billed",
              "shadow"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed",
              "left-client",
              "inactive"
            ]
          },
          "introduced_to_client": {
            "type": "boolean"
          },
          "receives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hub_access": {
            "enum": [
              "view",
              "comment"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "org"
        ],
        "additionalProperties": true
      }
    },
    "sow_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "people": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readers_note": {
      "type": "string"
    },
    "code_owners": {
      "description": "Who approves shared files. Either {people: [ids], reason} or, in older files, a plain list of ids.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "people": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  },
  "required": [
    "functions",
    "people"
  ],
  "additionalProperties": true
}
