{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/milestones.schema.json",
  "title": "milestones",
  "description": "Milestones. Ids are unique and the list is sorted by date.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "milestones"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "done",
              "upcoming",
              "at-risk",
              "slipped"
            ]
          },
          "inferred": {
            "type": "boolean",
            "description": "true when the milestone's date or status was inferred rather than read from a source. Never rendered; validate lists it for the reviewer."
          }
        },
        "required": [
          "id",
          "title",
          "date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "milestones"
  ],
  "additionalProperties": false
}
