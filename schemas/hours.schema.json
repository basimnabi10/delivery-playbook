{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/hours.schema.json",
  "title": "hours",
  "description": "Optional. Hours by role, sprint and week, from the timesheet only. No names, rates or budgets.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "hours"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis": {
      "enum": [
        "allocation",
        "logged"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week_ending": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sprint": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "hours": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "week_ending",
          "role",
          "hours"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "basis",
    "scope",
    "rows"
  ],
  "additionalProperties": false
}
