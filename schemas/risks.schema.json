{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/risks.schema.json",
  "title": "risks",
  "description": "Open dependencies on the client, risks and conflicts.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "risks"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dependency",
              "risk",
              "conflict"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "claim": {
            "type": "string"
          },
          "stated_by": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "items"
  ],
  "additionalProperties": false
}
