{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/versions.schema.json",
  "title": "versions",
  "description": "Release labels and periods. Labels may differ from the team's build labels.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "versions"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "period_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "period_end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "released",
              "in-progress",
              "unreleased",
              "planned"
            ],
            "description": "unreleased: the next version, with changes already on staging but not released. It is never the current version; the page shows it as the next release on staging."
          },
          "page_status": {
            "type": "object",
            "description": "Optional status label shown on the page instead of the one derived from the changes' environments.",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "tone": {
                "enum": [
                  "production",
                  "staging",
                  "internal",
                  "planned"
                ]
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "section_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Optional page anchor for this release, to keep links an earlier page used. The generated id (v1-4 style) stays as an alias."
          },
          "pr_range": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "label",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "versions"
  ],
  "additionalProperties": false
}
