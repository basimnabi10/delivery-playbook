{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/code-state.schema.json",
  "title": "code-state",
  "description": "Per repo: covered-through commit, production versus main, unmerged branches and tags. Written by the script.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "code-state"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covered_through": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "covered_through_commit": {
            "type": "string"
          },
          "production_commit": {
            "type": "string"
          },
          "main_commit": {
            "type": "string"
          },
          "unmerged_branches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "updated",
    "covered_through",
    "proposals",
    "repos"
  ],
  "additionalProperties": false
}
